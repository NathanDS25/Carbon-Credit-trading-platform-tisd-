generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = "postgresql://postgres.lqdlnxlkfevzkssxirab:Crackinmya%24%2469@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
  directUrl = "postgresql://postgres.lqdlnxlkfevzkssxirab:Crackinmya%24%2469@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
}

enum Role {
  NGO
  COMPANY
  ADMIN
}

enum PlantationStatus {
  PENDING
  PROCESSING
  VERIFIED
  REJECTED
}

enum ListingStatus {
  ACTIVE
  SOLD
  CANCELLED
}

enum TradeStatus {
  COMPLETED
  FAILED
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id            String    @id @default(uuid())
  firebaseUid   String    @unique
  name          String
  email         String    @unique
  role          Role
  walletAddress String?
  creditBalance Float     @default(0)
  createdAt     DateTime  @default(now())

  plantations   Plantation[]
  listings      CreditListing[] @relation("SellerListings")
  buys          Trade[]         @relation("BuyerTrades")
  sells         Trade[]         @relation("SellerTrades")
  sentMessages     ChatMessage[] @relation("SentMessages")
  receivedMessages ChatMessage[] @relation("ReceivedMessages")
  organizedMeetings Meeting[]    @relation("OrganizedMeetings")
  participatedMeetings Meeting[] @relation("ParticipatedMeetings")
}

model Plantation {
  id              String           @id @default(uuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id])
  name            String
  lat             Float
  lng             Float
  areaSqKm        Float
  imageUrl        String
  previousNDVI    Float?
  currentNDVI     Float?
  creditsAwarded  Float            @default(0)
  qualityGrade    String?          // A, B, C
  verifiedAt      DateTime?
  status          PlantationStatus @default(PENDING)
  txHash          String?
  satelliteImageUrl String?
  createdAt       DateTime         @default(now())

  satelliteJobs   SatelliteJob[]
}

model CreditListing {
  id                String        @id @default(uuid())
  sellerId          String
  seller            User          @relation("SellerListings", fields: [sellerId], references: [id])
  creditsAmount     Float
  pricePerCreditINR Float
  pricePerCreditETH String
  qualityGrade      String
  status            ListingStatus @default(ACTIVE)
  createdAt         DateTime      @default(now())

  trades            Trade[]
}

model Trade {
  id            String      @id @default(uuid())
  buyerId       String
  buyer         User        @relation("BuyerTrades", fields: [buyerId], references: [id])
  sellerId      String
  seller        User        @relation("SellerTrades", fields: [sellerId], references: [id])
  listingId     String
  listing       CreditListing @relation(fields: [listingId], references: [id])
  creditsAmount Float
  inrPaid       Float
  ethPaid       String
  txHash        String
  status        TradeStatus @default(COMPLETED)
  createdAt     DateTime    @default(now())
}

model SatelliteJob {
  id             String    @id @default(uuid())
  plantationId   String
  plantation     Plantation @relation(fields: [plantationId], references: [id])
  jobStatus      JobStatus @default(PENDING)
  ndviResult     Float?
  confidenceScore Float?
  isroApiRef     String?
  processedAt    DateTime?
  createdAt      DateTime  @default(now())
}

model ChatMessage {
  id          String   @id @default(uuid())
  senderId    String
  sender      User     @relation("SentMessages", fields: [senderId], references: [id])
  receiverId  String
  receiver    User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  message     String
  fileUrl     String?
  readAt      DateTime?
  createdAt   DateTime @default(now())
}

model Meeting {
  id            String   @id @default(uuid())
  organizerId   String
  organizer     User     @relation("OrganizedMeetings", fields: [organizerId], references: [id])
  participantId String
  participant   User     @relation("ParticipatedMeetings", fields: [participantId], references: [id])
  scheduledAt   DateTime
  meetLink      String
  status        String   @default("PENDING") // PENDING, CONFIRMED, CANCELLED
  createdAt     DateTime @default(now())
}
